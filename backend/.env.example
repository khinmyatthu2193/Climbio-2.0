NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://climbio:climbio@localhost:5432/climbio?schema=public
FRONTEND_URL=http://localhost:5173
# Generate independent secrets with at least 32 random characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-images
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Comma-separated platform administrator allowlist. Keep real values only in backend/.env.
ADMIN_EMAILS=admin@example.com
# Bootstrap account: must also appear in ADMIN_EMAILS. It is created only when absent.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
ADMIN_NAME=Climbio Admin
