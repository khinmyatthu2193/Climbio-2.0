generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum Currency {
  MMK
  USD
  THB
}

enum Role {
  ADMIN
  SHOP_OWNER
  MANAGER
  STAFF
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ShopApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  DECLINED
  SUSPENDED
}

enum ShopReviewAction {
  APPROVED
  CHANGES_REQUESTED
  DECLINED
  SUSPENDED
  REACTIVATED
  GENERAL_FEEDBACK
  RESUBMITTED
  REOPENED
}

enum AIInsightType {
  DAILY_REPORT
  SALES_ANALYSIS
  INVENTORY_ALERT
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  password      String
  name          String         @db.VarChar(100)
  shopName      String         @map("shop_name") @db.VarChar(100)
  slug          String         @unique @default(dbgenerated("'shop-' || substr(replace(gen_random_uuid()::text, '-'::text, ''::text), 1, 10)")) @db.VarChar(120)
  publicEnabled Boolean        @default(true) @map("public_enabled")
  shopLogo      String?        @map("shop_logo")
  shopAddress   String?        @map("shop_address")
  businessCategory String?     @map("business_category") @db.VarChar(100)
  businessDescription String?  @map("business_description")
  businessPhone String?        @map("business_phone") @db.VarChar(30)
  businessEmail String?        @map("business_email") @db.VarChar(255)
  cityTownship String?         @map("city_township") @db.VarChar(100)
  ownerRole String?            @map("owner_role") @db.VarChar(100)
  businessRegistrationNumber String? @map("business_registration_number") @db.VarChar(100)
  verificationDocument String? @map("verification_document")
  websiteUrl String?           @map("website_url") @db.VarChar(500)
  phone         String?        @db.VarChar(30)
  role          Role           @default(SHOP_OWNER)
  accountStatus AccountStatus  @default(ACTIVE) @map("account_status")
  approvalStatus ShopApprovalStatus @default(PENDING) @map("approval_status")
  submittedAt   DateTime?      @map("submitted_at")
  approvedAt    DateTime?      @map("approved_at")
  suspendedAt   DateTime?      @map("suspended_at")
  applicationVersion Int       @default(1) @map("application_version")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  products      Product[]
  categories    Category[]
  invoices      Invoice[]
  customers     Customer[]
  setting       Setting?
  refreshTokens RefreshToken[]
  aiInsights    AIInsight[]
  aiChatHistory AIChatHistory[]
  reviewsReceived ShopReview[] @relation("ShopReviewsReceived")
  reviewsPerformed ShopReview[] @relation("ShopReviewsPerformed")

  @@index([role, submittedAt, approvalStatus])
  @@map("users")
}

model ShopReview {
  id             String             @id @default(uuid()) @db.Uuid
  shopId         String             @map("shop_id") @db.Uuid
  adminId        String?            @map("admin_id") @db.Uuid
  action         ShopReviewAction
  previousStatus ShopApprovalStatus? @map("previous_status")
  nextStatus     ShopApprovalStatus? @map("next_status")
  feedback       String?
  version        Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at")
  shop           User               @relation("ShopReviewsReceived", fields: [shopId], references: [id], onDelete: Cascade)
  admin          User?              @relation("ShopReviewsPerformed", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("shop_reviews")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  price       Decimal   @db.Decimal(14, 2)
  costPrice   Decimal   @map("cost_price") @db.Decimal(14, 2)
  quantity    Int       @default(0)
  categoryId  String?   @map("category_id") @db.Uuid
  image       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  invoiceItems InvoiceItem[]

  @@unique([userId, name])
  @@index([userId, categoryId])
  @@index([userId, quantity])
  @@index([userId, isActive, categoryId])
  @@map("products")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([userId, name])
  @@map("categories")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  invoiceNumber String        @map("invoice_number") @db.VarChar(30)
  customerName  String        @map("customer_name") @db.VarChar(100)
  customerPhone String?       @map("customer_phone") @db.VarChar(30)
  subtotal      Decimal       @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]

  @@unique([userId, invoiceNumber])
  @@index([userId, status, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(100)
  quantity    Int
  price       Decimal  @db.Decimal(14, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String    @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  email        String?   @db.VarChar(255)
  address      String?
  totalSpent   Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  lastPurchase DateTime? @map("last_purchase")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
  @@map("customers")
}

model Setting {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  currency      Currency @default(MMK)
  invoiceFooter String?  @map("invoice_footer")
  companyName   String?  @map("company_name") @db.VarChar(100)
  companyLogo   String?  @map("company_logo")
  theme         String   @default("system") @db.VarChar(30)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AIInsight {
  id        String        @id @default(uuid()) @db.Uuid
  shopId    String        @map("shop_id") @db.Uuid
  type      AIInsightType
  content   String
  createdAt DateTime      @default(now()) @map("created_at")
  shop      User          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, type, createdAt])
  @@map("ai_insights")
}

model AIChatHistory {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  question  String
  answer    String
  createdAt DateTime @default(now()) @map("created_at")
  shop      User     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@map("ai_chat_history")
}
